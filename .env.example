CORE_BASE_URL=https://api.tastyworks.com
CORE_API_CLIENT_SECRET=clientsecrethere
CORE_API_REFRESH_TOKEN=refreshtokenhere
CORE_IPC_SOCKET=
CORE_OPTION_MARKET_SNAPSHOT_TTL_MS=30000
CORE_CASH_ACCOUNT_MAX_BUYING_POWER_PCT=0.6
CORE_QUOTE_STREAMER_MAX_RECONNECT_ATTEMPTS=3

# Bot scheduling
BOT_RUN_ON_SCHEDULE=false
BOT_RUN_INTERVAL_MS=
BOT_RUN_INTERVAL_MINUTES=

# Bot trading controls
BOT_DATA_DIR=
BOT_DO_NOT_TOUCH_GROUPS=
BOT_READ_ONLY_ACCOUNTS=
BOT_CLOSING_ONLY_RETRY_MS=1800000

# Live %-of-account seed sizing band (fraction OR integer-percent both accepted:
# 12 == 0.12, 35 == 0.35). Applies to BOTH accounts. Liquid names size toward
# the ceiling, thin monthlies fade to the floor. NB: seed size is governed
# ENTIRELY by percentages — there is no dollar clip (BOT_MAX_SEED_ORDER_COST was
# retired 2026-07-21).
SECRET_SEED_SIZING_FLOOR_PCT=12
SECRET_SEED_SIZING_CEILING_PCT=35

# Strategy: seed thresholds
STRATEGY_MARGIN_SEED_FROM_CASH_MIN_DOWN_PCT=6
STRATEGY_MARGIN_SEED_FROM_CASH_MAX_DOWN_PCT=14
STRATEGY_CASH_SEED_FROM_MARGIN_MIN_DOWN_PCT=8
STRATEGY_CASH_SEED_FROM_MARGIN_MAX_DOWN_PCT=20
STRATEGY_MAX_ASK_RETURN_PERC_FOR_BUY=0.2

# Strategy: per-position confirmation signals and max target exposure
STRATEGY_CROSS_ACCOUNT_YES_DOWN_PCT=10
STRATEGY_GATE_BASIC_PERCENT_OF_BALANCE_THRESHOLD=25
STRATEGY_GATE_STRONG_PERCENT_OF_BALANCE_THRESHOLD=30
STRATEGY_GATE_SINGLE_YES_MAX_TARGET_PCT=0.15
STRATEGY_GATE_BASIC_YES_MAX_TARGET_PCT=0.10
STRATEGY_GATE_BOTH_YES_MAX_TARGET_PCT=0.25
STRATEGY_GATE_STRONG_YES_MAX_TARGET_PCT=0.35
STRATEGY_MARGIN_MAX_TARGET_MULTIPLIER=1.33
STRATEGY_MARGIN_CROSS_ACCOUNT_THRESHOLD_MULTIPLIER=2
STRATEGY_GATE_BOOLEAN_BOOST_PCT=0.03

# Strategy: stop loss floors
STRATEGY_INTRADAY_STOP_LOSS_PCT=30
STRATEGY_EOD_STOP_LOSS_PCT=10

# Strategy: position sizing and exposure
STRATEGY_MAX_OPTION_SPREAD_PCT=0.3
STRATEGY_MARGIN_MAX_ENTRY_SPREAD_PCT=
STRATEGY_MIN_OPEN_INTEREST=0
STRATEGY_PHANTOM_QUOTE_GUARD_ENABLED=false
STRATEGY_MARGIN_MAX_BUY_EXPOSURE_PCT=0.12
STRATEGY_CASH_MAX_BUY_EXPOSURE_PCT=0.05
STRATEGY_MARGIN_DIP_TARGET_BOOST_MAX_PCT=0.25
STRATEGY_MARGIN_DIP_TARGET_BOOST_MAX_SPREAD_PCT=
STRATEGY_MAX_ALLOCATION_BUY_POSITION_MULTIPLE=3
STRATEGY_MAX_UNDERLYING_CONTRACTS=0

# Concentration caps on the seed size (fraction OR integer-percent accepted).
# Per-underlying cap is quality-scaled (thin names get a lower effective cap);
# combined cap bounds cash+margin exposure to the same name. Off when unset.
STRATEGY_MAX_UNDERLYING_ACCOUNT_PCT=60
STRATEGY_COMBINED_UNDERLYING_CAP_PCT=70
STRATEGY_MIN_LIQUIDITY_CAP_MULTIPLIER=0.4

# Total-margin-utilization leverage rail (MARGIN account only). Summed value of
# all open margin option positions may not exceed this MULTIPLE of margin NLV.
# This is a raw leverage multiple (1.5x), NOT a percent. Enforced by default.
STRATEGY_MARGIN_MAX_TOTAL_UTILIZATION=1.5
STRATEGY_OVERNIGHT_REDUCTION_DAYS_TO_SELLOFF=6
STRATEGY_OVERNIGHT_REDUCTION_START_FLOOR_PCT=20
STRATEGY_MIN_IV_RANK_PCT=20
STRATEGY_MARGIN_TARGET_CALL_DELTA=0.35
STRATEGY_MARGIN_MAX_TARGET_DTE=7
STRATEGY_CASH_MIN_TARGET_DTE=7

# Secret feed
SECRET_SOCKET_URL=
SECRET_SOCKET_AUTH_KEY=
SECRET_SOCKET_TIMEOUT_MS=5000
SECRET_DATA_UPDATE_POSITIONS_KEY=
SECRET_AUTO_SEED_ON_POSITIONS_UPDATE=false
SECRET_AUTO_SEED_ON_TICKER_RECS_UPDATE=false
SECRET_AUTO_SEED_START_TIME=06:30
SECRET_AUTO_SEED_COOLDOWN_MS=600000
